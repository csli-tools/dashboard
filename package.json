{
  "name": "wasmd-blessed",
  "version": "0.1.0",
  "description": "Cosmos blockchain's CosmWasm dashboard using JavaScript blessed libraries",
  "main": "index.ts",
  "scripts": {
    "start": "nodemon --watch 'src/**/*' -e ts,tsx --exec 'npm run lint && ts-node' ./src/index.ts",
    "pane": "nodemon --watch 'src/new-pane.ts' -e ts,tsx --exec 'npm run lint:pane && ts-node' ./src/new-pane.ts",
    "lint": "eslint src",
    "lint:pane": "eslint src/new-pane.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "cosmwasm",
    "cosmos",
    "blockchain",
    "juno",
    "react-blessed",
    "blessed",
    "smart contracts"
  ],
  "author": "Mike Purvis",
  "license": "Apache-2.0",
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ]
  },
  "dependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.18.6",
    "@babel/plugin-transform-flow-strip-types": "^7.18.6",
    "@babel/preset-env": "^7.18.6",
    "@babel/preset-react": "^7.18.6",
    "@babel/register": "^7.18.6",
    "@cosmjs/amino": "^0.28.11",
    "@cosmjs/cosmwasm-stargate": "^0.28.11",
    "@cosmjs/crypto": "^0.28.11",
    "@cosmjs/encoding": "^0.28.11",
    "@cosmjs/proto-signing": "^0.28.11",
    "@cosmjs/stargate": "^0.28.11",
    "blessed": "^0.1.81",
    "cosmjs-types": "^0.5.0",
    "dotenv": "^16.0.1",
    "inquirer": "^8.2.4",
    "node-fetch": "^3.2.8",
    "node-jq": "^2.3.3",
    "react": "^17.0.2",
    "react-blessed": "^0.7.2",
    "ws": "^8.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.9",
    "@babel/core": "^7.18.9",
    "@babel/preset-flow": "^7.18.6",
    "@types/blessed": "^0.1.19",
    "@types/react-blessed": "^0.7.1",
    "@types/ws": "^8.5.3",
    "eslint": "^8.21.0",
    "eslint-config-react-app": "^7.0.1",
    "nodemon": "^2.0.19",
    "ts-node": "^10.9.1"
  }
}
