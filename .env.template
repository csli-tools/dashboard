# Remember you'll want to have your own .env file,
#   perhaps based on this template

# NEAR Network Configuration
# Options: mainnet, testnet, localnet
NEAR_NETWORK=mainnet

# FastNEAR Authorization Token (required for mainnet/testnet)
# Get your token from https://fastnear.com
FASTNEAR_AUTH_TOKEN=your_auth_token_here

# WebSocket Configuration
# Port for WebSocket server (default: 63736)
WS_PORT=63736

# WebSocket high water mark in bytes (default: 1000000 = 1MB)
WS_HIGH_WATER_MARK=1000000

# Block Polling Configuration
# Polling interval in milliseconds (default: 1000)
POLL_INTERVAL_MS=1000

# Maximum blocks to catch up per poll cycle (default: 5)
POLL_MAX_CATCHUP=5

# Concurrent chunk fetches per block (default: 4)
POLL_CHUNK_CONCURRENCY=4

# RPC Configuration
# RPC request timeout in milliseconds (default: 8000)
RPC_TIMEOUT_MS=8000

# Number of RPC retries on failure (default: 2)
RPC_RETRIES=2

# JSON Formatting Configuration
# Formatter type: worker or wasm (default: worker)
JSON_FORMATTER=worker

# JSON formatting timeout in milliseconds (default: 5000)
JSON_FORMAT_TIMEOUT_MS=5000

# Circuit Breaker Configuration
# Number of failures before opening circuit (default: 8)
CB_FAILURE_THRESHOLD=8

# Time to wait before attempting reset in milliseconds (default: 10000)
CB_RESET_AFTER_MS=10000

# Blessed Runtime Configuration
# Runtime: neo (default) or classic
BLESSED_RUNTIME=neo

# Render Performance Configuration
# Target frames per second (default: 30)
RENDER_FPS=30

# FPS choices for Ctrl+O toggle (default: 20,30,60)
RENDER_FPS_CHOICES=20,30,60

# Display Configuration
# Show raw base64 args in function calls (default: false)
SHOW_ARGS_BASE64=false

# History & Persistence Configuration
# SQLite database path for transaction history (default: ./csli_history.db)
SQLITE_DB_PATH=./csli_history.db

# Credentials Configuration
# Path to NEAR credentials directory (default: ~/.near-credentials)
NEAR_CREDENTIALS_DIR=~/.near-credentials